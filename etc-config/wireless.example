
config wifi-device 'radio0'
	option type 'mac80211'
	option path 'platform/soc/18000000.wifi'
	option band '2g'
	option channel '1'
	option htmode 'HE20'
	option cell_density '0'

config wifi-device 'radio1'
	option type 'mac80211'
	option path 'platform/soc/18000000.wifi+1'
	option band '5g'
	option channel '36'
	option htmode 'HE80'
	option cell_density '0'

config wifi-iface 'wsta24'
	option device 'radio0'
	option mode 'sta'
	option ssid 'YOUR_WIFI_SSID'
	option encryption 'psk2'
	option key 'YOUR_WIFI_PASSWORD'
	option network 'wan24'

config wifi-iface 'wsta5'
	option device 'radio1'
	option mode 'sta'
	option ssid 'YOUR_WIFI_SSID'
	option encryption 'psk2'
	option key 'YOUR_WIFI_PASSWORD'
	option network 'wan5'

config wifi-iface 'ap24'
	option device 'radio0'
	option mode 'ap'
	option ssid 'YOUR_WIFI_SSID'
	option encryption 'psk2'
	option key 'YOUR_WIFI_PASSWORD'
	option network 'lan'

config wifi-iface 'ap5'
	option device 'radio1'
	option mode 'ap'
	option ssid 'YOUR_WIFI_SSID'
	option encryption 'psk2'
	option key 'YOUR_WIFI_PASSWORD'
	option network 'lan'

