#!/bin/sh
# /usr/bin/tunnel-off
WHITE="/sys/class/leds/white:status/brightness"
RED="/sys/class/leds/red:power/brightness"
TURNABLE_BIN="/usr/bin/turnable-client"
TURNABLE_PIDFILE="/var/run/turnable-client.pid"

logger -t tunnel-switch "Activating direct mode"
echo 0 > "$WHITE"
echo 1 > "$RED"

# 1. Temporary blackhole to prevent traffic leak during switchover
ip rule add from 192.168.99.0/24 unreachable priority 699 2>/dev/null

# 2. Remove WireGuard routing rules
ip rule del priority 700 2>/dev/null
ip rule del priority 750 2>/dev/null

# 3. Bring down WireGuard before stopping Turnable
ifdown wg0 2>/dev/null

# 4. Stop turnable-client
if [ -f "$TURNABLE_PIDFILE" ]; then
    PID=$(cat "$TURNABLE_PIDFILE")
    if kill -0 "$PID" 2>/dev/null; then
        logger -t tunnel-switch "Stopping turnable-client (pid=$PID)"
        kill "$PID" 2>/dev/null
        elapsed=0
        while [ $elapsed -lt 5 ] && kill -0 "$PID" 2>/dev/null; do
            sleep 1
            elapsed=$((elapsed + 1))
        done
        kill -0 "$PID" 2>/dev/null && kill -9 "$PID" 2>/dev/null
        logger -t tunnel-switch "turnable-client stopped"
    else
        logger -t tunnel-switch "turnable-client already dead"
    fi
    rm -f "$TURNABLE_PIDFILE"
else
    # No pidfile - fallback kill by name
    pkill -f "^$TURNABLE_BIN client" 2>/dev/null
    logger -t tunnel-switch "turnable-client stopped (by name)"
fi

# 5. Restore mwan3 for LAN traffic
iptables -t mangle -D PREROUTING -i br-lan -j RETURN 2>/dev/null || true

# 6. Flush LAN conntrack entries (mwan3 will re-mark on new connections)
conntrack -D -s 192.168.99.0/24 2>/dev/null || true
conntrack -D -d 192.168.99.0/24 2>/dev/null || true

# 7. Remove blackhole (mwan3 is ready to handle traffic)
ip rule del priority 699 2>/dev/null

# 8. Flush route cache
ip route flush cache

# 9. Remove state marker
rm -f /var/run/tunnel-active
logger -t tunnel-switch "Direct mode ON"
