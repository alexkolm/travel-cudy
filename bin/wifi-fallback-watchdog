#!/bin/sh
set -eu

LOCK_FILE="/var/run/wifi-fallback.lock"
STATE_DIR="/var/run/wifi-fallback"
LOG_TAG="wifi-fallback"
CHECK_INTERVAL="${CHECK_INTERVAL:-10}"
PROBE_INTERVAL="${PROBE_INTERVAL:-60}"
ASSOC_TIMEOUT="${ASSOC_TIMEOUT:-60}"

mkdir -p "$STATE_DIR"

log() { logger -t "$LOG_TAG" "$*"; }

with_lock() {
    exec 9>"$LOCK_FILE"
    flock -n 9 || exit 0
}

now() { date +%s; }

iface_exists() {
    iw dev 2>/dev/null | grep -q "Interface $1"
}

is_link_up() {
    iface_exists "$1" || return 1
    iw dev "$1" link 2>/dev/null | grep -q "Connected to"
}

ap_is_up() {
    iface_exists "$1" || return 1
    iw dev "$1" info 2>/dev/null | grep -q "type AP"
}

# Passive scan for SSID via AP interface - does not disturb AP or clients
ssid_visible() {
    local ap_if="$1"
    local ssid="$2"
    iface_exists "$ap_if" || return 1
    iw dev "$ap_if" scan 2>/dev/null | grep -q "SSID: ${ssid}"
}

# Restore AP if missing - reload only affected radio
ensure_ap() {
    local ap_if="$1"
    local uci_ap="$2"
    local radio="$3"
    if ! ap_is_up "$ap_if"; then
        log "AP $ap_if not up → restoring ($radio)"
        uci set "wireless.${uci_ap}.disabled=0"
        uci commit wireless
        wifi reload "$radio" >/dev/null 2>&1 || wifi reload >/dev/null 2>&1 || true
        sleep 3
        if ap_is_up "$ap_if"; then
            log "AP $ap_if restored OK"
        else
            log "WARNING: AP $ap_if still not up after restore"
        fi
    fi
}

# Enable STA: clear disabled, reload radio, trigger DHCP
enable_sta() {
    local uci_sta="$1"
    local radio="$2"
    local net="$3"
    log "Enabling STA: $uci_sta on $radio"
    uci set "wireless.${uci_sta}.disabled=0"
    uci commit wireless
    wifi reload "$radio" >/dev/null 2>&1 || wifi reload >/dev/null 2>&1 || true
    sleep 3
    ifup "$net" 2>/dev/null || true
}

# Disable STA: set disabled, reload radio
# AP stays up because its disabled flag is untouched
disable_sta() {
    local uci_sta="$1"
    local radio="$2"
    local net="$3"
    log "Disabling STA: $uci_sta on $radio"
    ifdown "$net" 2>/dev/null || true
    uci set "wireless.${uci_sta}.disabled=1"
    uci commit wireless
    wifi reload "$radio" >/dev/null 2>&1 || wifi reload >/dev/null 2>&1 || true
    sleep 2
}

state_file() { echo "$STATE_DIR/$1.state"; }
ts_file()    { echo "$STATE_DIR/$1.ts"; }

get_state() {
    [ -f "$(state_file "$1")" ] && cat "$(state_file "$1")" || echo "init"
}

set_state() {
    echo "$2" > "$(state_file "$1")"
    now > "$(ts_file "$1")"
    log "$1 state → $2"
}

get_ts() {
    [ -f "$(ts_file "$1")" ] && cat "$(ts_file "$1")" || echo 0
}

band_logic() {
    local band="$1"
    local sta_if="$2"
    local uci_sta="$3"
    local radio="$4"
    local net="$5"
    local ap_if="$6"
    local uci_ap="$7"
    local ssid="$8"
    local STATE NOW TS elapsed

    NOW=$(now)
    STATE=$(get_state "$band")
    TS=$(get_ts "$band")

    # AP must always be up - check every iteration
    ensure_ap "$ap_if" "$uci_ap" "$radio"

    # STA is connected
    if is_link_up "$sta_if"; then
        if [ "$STATE" != "connected" ]; then
            log "$band STA connected on $sta_if"
            set_state "$band" "connected"
        fi
        return
    fi

    # STA was connected but dropped - retry immediately without scan
    if [ "$STATE" = "connected" ]; then
        log "$band STA lost → retry immediately"
        enable_sta "$uci_sta" "$radio" "$net"
        set_state "$band" "trying"
        return
    fi

    # First run - attempt immediately
    if [ "$STATE" = "init" ]; then
        log "$band init → enable STA"
        enable_sta "$uci_sta" "$radio" "$net"
        set_state "$band" "trying"
        return
    fi

    # Waiting for association
    if [ "$STATE" = "trying" ]; then
        elapsed=$((NOW - TS))
        if [ "$elapsed" -lt "$ASSOC_TIMEOUT" ]; then
            return
        fi
        log "$band assoc timeout after ${elapsed}s → STA off, AP solo"
        disable_sta "$uci_sta" "$radio" "$net"
        set_state "$band" "off"
        return
    fi

    # No uplink - periodic passive scan, NO wifi reload unless SSID found
    if [ "$STATE" = "off" ]; then
        elapsed=$((NOW - TS))
        if [ "$elapsed" -lt "$PROBE_INTERVAL" ]; then
            return
        fi
        log "$band probing for SSID '$ssid' via $ap_if (passive scan)"
        if ssid_visible "$ap_if" "$ssid"; then
            log "$band SSID '$ssid' found → enable STA"
            enable_sta "$uci_sta" "$radio" "$net"
            set_state "$band" "trying"
        else
            log "$band SSID '$ssid' not visible → stay off, AP untouched"
            # Update timestamp to reset probe interval - no radio reload
            set_state "$band" "off"
        fi
        return
    fi
}

main() {
    with_lock
    #          band  sta_if      uci_sta  radio    net     ap_if      uci_ap  ssid
    band_logic "2g"  "phy0-sta0" "wsta24" "radio0" "wan24" "phy0-ap0" "ap24"  "TV24"
    band_logic "5g"  "phy1-sta0" "wsta5"  "radio1" "wan5"  "phy1-ap0" "ap5"   "uplink"
}

while true; do
    main
    sleep "$CHECK_INTERVAL"
done
