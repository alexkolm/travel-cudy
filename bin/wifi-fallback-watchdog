#!/bin/sh
set -eu

LOCK_FILE="/var/run/wifi-fallback.lock"
STATE_DIR="/var/run/wifi-fallback"
LOG_TAG="wifi-fallback"

CHECK_INTERVAL="${CHECK_INTERVAL:-10}"
STA_TIMEOUT="${STA_TIMEOUT:-45}"
MIN_STATE_SECS="${MIN_STATE_SECS:-60}"
UPLINK_MIN_RSSI="${UPLINK_MIN_RSSI:--70}"
KNOWN_SSIDS="${KNOWN_SSIDS:-uplink TV5}"

# AP-priority mode (per band): keep AP stable when STA uplink for this band is unavailable,
# periodically probe STA uplink and return to sta+ap on success.
AP_PRIORITY_24="${AP_PRIORITY_24:-1}"
PROBE_INTERVAL_24="${PROBE_INTERVAL_24:-180}"
PROBE_WINDOW_24="${PROBE_WINDOW_24:-12}"

AP_PRIORITY_5="${AP_PRIORITY_5:-1}"
PROBE_INTERVAL_5="${PROBE_INTERVAL_5:-180}"
PROBE_WINDOW_5="${PROBE_WINDOW_5:-12}"

mkdir -p "$STATE_DIR"
log() { logger -t "$LOG_TAG" "$*"; }

with_lock() { exec 9>"$LOCK_FILE"; flock -n 9 || exit 0; }
now_ts() { date +%s; }

sf() { echo "$STATE_DIR/$1.state"; }
ff() { echo "$STATE_DIR/$1.fail"; }
tf() { echo "$STATE_DIR/$1.last_change"; }
pf() { echo "$STATE_DIR/$1.last_probe"; }

getv() { [ -f "$1" ] && cat "$1" || echo "$2"; }
setv() { echo "$2" > "$1"; }

state() { getv "$(sf "$1")" "sta+ap"; }
set_state() { setv "$(sf "$1")" "$2"; setv "$(tf "$1")" "$(now_ts)"; }
failv() { getv "$(ff "$1")" 0; }
set_fail() { setv "$(ff "$1")" "$2"; }
secs_in_state() { echo $(( $(now_ts) - $(getv "$(tf "$1")" "$(now_ts)") )); }
secs_since_probe() { echo $(( $(now_ts) - $(getv "$(pf "$1")" 0) )); }
mark_probe() { setv "$(pf "$1")" "$(now_ts)"; }

wifi_reload() { wifi reload >/dev/null 2>&1 || true; }

uci_set_bool() {
  local sec="$1" val="$2" cur
  cur="$(uci -q get "wireless.${sec}.disabled" || echo 0)"
  [ "$cur" = "$val" ] && return 1
  uci set "wireless.${sec}.disabled=$val"
  return 0
}

apply_config_if_changed() {
  if [ "${CFG_CHANGED:-0}" = "1" ]; then
    uci commit wireless
    wifi_reload
    CFG_CHANGED=0
  fi
}

is_link_up() { iw dev "$1" link 2>/dev/null | grep -q "Connected to"; }
wan_up() { ifstatus "$1" 2>/dev/null | grep -q '"up": true'; }

ssid_ok() {
  local sta_if="$1" ssid rssi rssi_int
  iw dev "$sta_if" scan 2>/dev/null > "$STATE_DIR/${sta_if}.scan" || true
  for ssid in $KNOWN_SSIDS; do
    rssi="$(grep -A5 "SSID: ${ssid}$" "$STATE_DIR/${sta_if}.scan" | grep -m1 "signal:" | sed -E 's/.*signal: *(-?[0-9]+(\.[0-9]+)?) .*/\1/' || true)"
    [ -n "$rssi" ] || continue
    rssi_int="${rssi%%.*}"
    if [ "$rssi_int" -ge "$UPLINK_MIN_RSSI" ]; then
      log "$sta_if sees '$ssid' at $rssi dBm"
      return 0
    fi
  done
  return 1
}

band_tick_ap_priority() {
  local b="$1" sta_sec="$2" ap_sec="$3" sta_if="$4" netif="$5" probe_interval="$6" probe_window="$7"
  local st fv el since_probe

  st="$(state "$b")"; el="$(secs_in_state "$b")"

  if is_link_up "$sta_if"; then
    CFG_CHANGED=0
    uci_set_bool "$ap_sec" 0 && CFG_CHANGED=1 || true
    uci_set_bool "$sta_sec" 0 && CFG_CHANGED=1 || true
    apply_config_if_changed
    if ! wan_up "$netif"; then ifup "$netif" 2>/dev/null || true; fi
    set_fail "$b" 0
    [ "$st" = "sta+ap" ] || { set_state "$b" "sta+ap"; log "$b -> sta+ap"; }
    return
  fi

  # Not linked: keep AP stable by disabling STA on this band.
  CFG_CHANGED=0
  uci_set_bool "$ap_sec" 0 && CFG_CHANGED=1 || true
  uci_set_bool "$sta_sec" 1 && CFG_CHANGED=1 || true
  apply_config_if_changed
  ifdown "$netif" 2>/dev/null || true

  fv="$(failv "$b")"; fv=$((fv + CHECK_INTERVAL)); set_fail "$b" "$fv"
  [ "$st" = "ap-only" ] || { set_state "$b" "ap-only"; log "$b -> ap-only (STA disabled for AP stability)"; }

  since_probe="$(secs_since_probe "$b")"
  [ "$since_probe" -ge "$probe_interval" ] || return

  mark_probe "$b"
  log "$b probe: enabling STA for ${probe_window}s"
  CFG_CHANGED=0
  uci_set_bool "$sta_sec" 0 && CFG_CHANGED=1 || true
  apply_config_if_changed
  sleep "$probe_window"

  if is_link_up "$sta_if" && ssid_ok "$sta_if"; then
    ifup "$netif" 2>/dev/null || true
    set_state "$b" "sta+ap"
    set_fail "$b" 0
    log "$b probe success -> sta+ap"
    return
  fi

  CFG_CHANGED=0
  uci_set_bool "$sta_sec" 1 && CFG_CHANGED=1 || true
  apply_config_if_changed
  ifdown "$netif" 2>/dev/null || true
  set_state "$b" "ap-only"
  log "$b probe failed -> keep ap-only"
}

band_tick_l3_fallback() {
  local b="$1" sta_sec="$2" ap_sec="$3" sta_if="$4" netif="$5"
  local st fv el

  CFG_CHANGED=0
  uci_set_bool "$ap_sec" 0 && CFG_CHANGED=1 || true
  uci_set_bool "$sta_sec" 0 && CFG_CHANGED=1 || true
  apply_config_if_changed

  st="$(state "$b")"; el="$(secs_in_state "$b")"
  if is_link_up "$sta_if"; then
    if ! wan_up "$netif"; then ifup "$netif" 2>/dev/null || true; fi
    set_fail "$b" 0
    [ "$st" = "sta+ap" ] || set_state "$b" "sta+ap"
    return
  fi

  fv="$(failv "$b")"; fv=$((fv + CHECK_INTERVAL)); set_fail "$b" "$fv"
  if [ "$st" = "sta+ap" ] && [ "$fv" -ge "$STA_TIMEOUT" ] && [ "$el" -ge "$MIN_STATE_SECS" ]; then
    ifdown "$netif" 2>/dev/null || true
    set_state "$b" "ap-only"
    log "$b -> ap-only"
  fi
}

main() {
  with_lock

  if [ "$AP_PRIORITY_24" = "1" ]; then
    band_tick_ap_priority "2g" "wsta24" "ap24" "phy0-sta0" "wan24" "$PROBE_INTERVAL_24" "$PROBE_WINDOW_24"
  else
    band_tick_l3_fallback "2g" "wsta24" "ap24" "phy0-sta0" "wan24"
  fi

  if [ "$AP_PRIORITY_5" = "1" ]; then
    band_tick_ap_priority "5g" "wsta5" "ap5" "phy1-sta0" "wan5" "$PROBE_INTERVAL_5" "$PROBE_WINDOW_5"
  else
    band_tick_l3_fallback "5g" "wsta5" "ap5" "phy1-sta0" "wan5"
  fi
}

while true; do
  main
  sleep "$CHECK_INTERVAL"
done

