#!/bin/sh
set -eu

LOCK_FILE="/var/run/wifi-fallback.lock"
STATE_DIR="/var/run/wifi-fallback"
LOG_TAG="wifi-fallback"

CHECK_INTERVAL="${CHECK_INTERVAL:-10}"
STA_TIMEOUT="${STA_TIMEOUT:-45}"
MIN_STATE_SECS="${MIN_STATE_SECS:-60}"

mkdir -p "$STATE_DIR"

log() { logger -t "$LOG_TAG" "$*"; }

with_lock() {
  exec 9>"$LOCK_FILE"
  flock -n 9 || exit 0
}

now() { date +%s; }

sf() { echo "$STATE_DIR/$1.state"; }
tf() { echo "$STATE_DIR/$1.ts"; }
ff() { echo "$STATE_DIR/$1.fail"; }

getv() { [ -f "$1" ] && cat "$1" || echo "$2"; }
setv() { echo "$2" > "$1"; }

state() { getv "$(sf "$1")" "sta+ap"; }
set_state() { setv "$(sf "$1")" "$2"; setv "$(tf "$1")" "$(now)"; }

failv() { getv "$(ff "$1")" 0; }
set_fail() { setv "$(ff "$1")" "$2"; }

secs_in_state() {
  echo $(( $(now) - $(getv "$(tf "$1")" "$(now)") ))
}

iface_exists() {
  iw dev 2>/dev/null | grep -q "Interface $1"
}

is_link_up() {
  iface_exists "$1" || return 1
  iw dev "$1" link 2>/dev/null | grep -q "Connected to"
}

wan_up() {
  ifstatus "$1" 2>/dev/null | grep -q '"up": true'
}

uci_set_bool() {
  local sec="$1" val="$2" cur
  cur="$(uci -q get "wireless.${sec}.disabled" || echo 0)"
  [ "$cur" = "$val" ] && return 1
  uci set "wireless.${sec}.disabled=$val"
  return 0
}

apply_changes() {
  if [ "${CFG_CHANGED:-0}" = "1" ]; then
    uci commit wireless
    CFG_CHANGED=0
  fi
}

ensure_ap_enabled() {
  CFG_CHANGED=0
  uci_set_bool "ap24" 0 && CFG_CHANGED=1 || true
  uci_set_bool "ap5"  0 && CFG_CHANGED=1 || true
  apply_changes
}

enable_sta() {
  local sta="$1" net="$2"

  CFG_CHANGED=0
  uci_set_bool "$sta" 0 && CFG_CHANGED=1 || true
  apply_changes

  if ! wan_up "$net"; then
    ifup "$net" 2>/dev/null || true
  fi
}

disable_sta() {
  local sta="$1" net="$2"

  CFG_CHANGED=0
  uci_set_bool "$sta" 1 && CFG_CHANGED=1 || true
  apply_changes

  ifdown "$net" 2>/dev/null || true
}

band_tick() {
  local b="$1" sta="$2" ap="$3" sta_if="$4" net="$5"
  local st fv el

  st="$(state "$b")"
  el="$(secs_in_state "$b")"

  if is_link_up "$sta_if"; then
    enable_sta "$sta" "$net"
    set_fail "$b" 0

    [ "$st" = "sta+ap" ] || {
      set_state "$b" "sta+ap"
      log "$b -> sta+ap"
    }
    return
  fi

  # Give STA time after boot
  if [ "$el" -lt "$STA_TIMEOUT" ]; then
    return
  fi

  fv="$(failv "$b")"
  fv=$((fv + CHECK_INTERVAL))
  set_fail "$b" "$fv"

  if [ "$fv" -ge "$STA_TIMEOUT" ] && [ "$el" -ge "$MIN_STATE_SECS" ]; then
    disable_sta "$sta" "$net"

    [ "$st" = "ap-only" ] || {
      set_state "$b" "ap-only"
      log "$b -> ap-only"
    }
  fi
}

main() {
  with_lock

  # Always keep AP enabled
  ensure_ap_enabled

  # Detect uplinks
  UPLINK_24=0
  UPLINK_5=0

  is_link_up "phy0-sta0" && UPLINK_24=1
  is_link_up "phy1-sta0" && UPLINK_5=1

  # If uplink on 2.4 → disable 5 GHz STA (critical fix)
  if [ "$UPLINK_24" = "1" ] && [ "$UPLINK_5" = "0" ]; then
    disable_sta "wsta5" "wan5"
  fi

  # If uplink on 5 GHz → disable 2.4 STA
  if [ "$UPLINK_5" = "1" ] && [ "$UPLINK_24" = "0" ]; then
    disable_sta "wsta24" "wan24"
  fi

  # If any uplink is active → do nothing else
  if [ "$UPLINK_24" = "1" ] || [ "$UPLINK_5" = "1" ]; then
    return
  fi

  # No uplink → fallback logic
  band_tick "2g" "wsta24" "ap24" "phy0-sta0" "wan24"
  band_tick "5g" "wsta5"  "ap5"  "phy1-sta0" "wan5"
}

while true; do
  main
  sleep "$CHECK_INTERVAL"
done
